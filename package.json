{
  "name": "fundacao-toque",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "node scripts/seed-firestore.mjs seed",
    "seed:reset": "node scripts/seed-firestore.mjs reset",
    "seed:cleanup": "node scripts/seed-firestore.mjs cleanup",
    "migrate:turmas": "node scripts/migrate-legacy-turmas.mjs",
    "anexos:orfaos": "node scripts/anexos-orfaos.mjs",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage --project fundacao-toque-rules-test \"vitest run --no-file-parallelism tests/firestore/rules.test.ts tests/storage/rules.test.ts\"",
    "audit:firestore": "node scripts/audit-firestore.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.35.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CauanMendes/fundacao-toque.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CauanMendes/fundacao-toque/issues"
  },
  "homepage": "https://github.com/CauanMendes/fundacao-toque#readme"
}
