rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Padrão: negar tudo. Acesso concedido apenas por regras explícitas.
    match /{documento=**} {
      allow read, write: if false;
    }

    // Perfis: direcao | pedagogia | administrativo
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasUserDoc() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    function userRole() {
      return isActiveUser()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel
        : null;
    }

    function isDirection() {
      return isActiveUser() && userRole() == 'direcao';
    }

    function isPedagogue() {
      return isActiveUser() && userRole() == 'pedagogia';
    }

    function isAdministrative() {
      return isActiveUser() && userRole() == 'administrativo';
    }

    function canUseSystem() {
      return isDirection() || isPedagogue() || isAdministrative();
    }

    function validPrincipalAfterWrite(studentId) {
      return request.resource.data.responsavel_principal_id is string &&
        existsAfter(/databases/$(database)/documents/alunos/$(studentId)/responsaveis/$(request.resource.data.responsavel_principal_id)) &&
        getAfter(/databases/$(database)/documents/alunos/$(studentId)/responsaveis/$(request.resource.data.responsavel_principal_id)).data.ativo == true &&
        getAfter(/databases/$(database)/documents/alunos/$(studentId)/responsaveis/$(request.resource.data.responsavel_principal_id)).data.principal == true;
    }

    function isReportDraft(reportId) {
      return exists(/databases/$(database)/documents/relatorios_pedagogicos/$(reportId)) &&
        get(/databases/$(database)/documents/relatorios_pedagogicos/$(reportId)).data.status == 'rascunho';
    }

    // Perfis são provisionados por Direção; usuário não pode criar, alterar ou remover o próprio papel.
    match /usuarios/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isDirection());
      allow list: if isDirection();
      allow create, update: if isDirection();
      allow delete: if false;
    }

    // Diretório mínimo usado pelos seletores de profissional e autoria dos registros.
    match /usuarios_publicos/{userId} {
      allow read: if canUseSystem() && resource.data.ativo == true;
      allow create, update: if isDirection();
      allow delete: if false;
    }

    // alunos — Direção e Administrativo gerenciam cadastro; Pedagogia lê e atualiza.
    match /alunos/{studentId} {
      allow read: if canUseSystem();
      allow create: if (isDirection() || isAdministrative()) && validPrincipalAfterWrite(studentId);
      allow delete: if isDirection() || isAdministrative();
      allow update: if (isDirection() || isAdministrative() || isPedagogue()) &&
        (!request.resource.data.keys().hasAny(['responsavel_principal_id']) ||
          validPrincipalAfterWrite(studentId));

      // Subcoleção do aluno: ficha médica 1:1 — dados sensíveis (LGPD); ajustar com a Fundação.
      match /ficha_medica/{fichaId} {
        allow read: if isDirection() || isPedagogue();
        allow create: if isDirection() || isAdministrative();
        allow update, delete: if isDirection() || isPedagogue();
      }

      // Subcoleção: responsáveis do aluno
      match /responsaveis/{guardianId} {
        allow read: if canUseSystem();
        allow create, update: if (isDirection() || isAdministrative()) &&
          existsAfter(/databases/$(database)/documents/alunos/$(studentId)) &&
          request.resource.data.principal == (guardianId == getAfter(/databases/$(database)/documents/alunos/$(studentId)).data.responsavel_principal_id) &&
          (request.resource.data.ativo == true || request.resource.data.principal == false);
        allow delete: if isDirection() || isAdministrative();
      }

      // Subcoleção: documentos do aluno (ficha médica, matrícula, autorização de imagem)
      match /documentos/{documentId} {
        allow read: if canUseSystem() &&
          (resource.data.tipo_documento != 'ficha_medica' || isDirection() || isPedagogue());
        allow create: if (isDirection() || isAdministrative()) &&
          request.resource.data.tamanho_bytes <= 512000 &&
          request.resource.data.data_url is string &&
          request.resource.data.data_url.size() <= 700000;
        allow update, delete: if (isDirection() || isAdministrative()) &&
          (resource.data.tipo_documento != 'ficha_medica' || isDirection() || isPedagogue());
      }
    }

    match /turmas/{classId} {
      allow read: if canUseSystem();
      allow create, update, delete: if isDirection() || isPedagogue() || isAdministrative();
    }

    match /oficinas/{workshopId} {
      allow read: if canUseSystem();
      allow create, update, delete: if isDirection() || isPedagogue() || isAdministrative();
    }

    // Vínculo turma-oficina: fonte da verdade de horários e responsáveis.
    // ID determinístico turma__oficina impede dois vínculos para o mesmo par;
    // vínculos não são apagados, apenas inativados (histórico preservado).
    function isHora(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isDataOpcional(h, campo) {
      return !(campo in h) || h[campo] == null ||
        (h[campo] is string && h[campo].matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }

    function horarioValido(h) {
      return h is map &&
        h.keys().hasAll(['dia_semana', 'hora_inicio', 'hora_fim']) &&
        h.keys().hasOnly(['dia_semana', 'hora_inicio', 'hora_fim', 'valido_de', 'valido_ate']) &&
        h.dia_semana is int && h.dia_semana >= 1 && h.dia_semana <= 7 &&
        isHora(h.hora_inicio) && isHora(h.hora_fim) && h.hora_inicio < h.hora_fim &&
        isDataOpcional(h, 'valido_de') && isDataOpcional(h, 'valido_ate') &&
        (h.get('valido_de', null) == null || h.get('valido_ate', null) == null ||
          h.valido_de <= h.valido_ate);
    }

    function horariosValidos(hs) {
      return hs is list && hs.size() >= 1 && hs.size() <= 7 &&
        horarioValido(hs[0]) &&
        (hs.size() < 2 || horarioValido(hs[1])) &&
        (hs.size() < 3 || horarioValido(hs[2])) &&
        (hs.size() < 4 || horarioValido(hs[3])) &&
        (hs.size() < 5 || horarioValido(hs[4])) &&
        (hs.size() < 6 || horarioValido(hs[5])) &&
        (hs.size() < 7 || horarioValido(hs[6]));
    }

    function vinculoValido(data) {
      return data.turma_id is string && data.oficina_id is string &&
        data.ativo is bool &&
        data.ids_usuarios_responsaveis is list &&
        data.ids_usuarios_responsaveis.size() <= 20 &&
        // Vínculo ativo exige responsáveis e horários válidos; um vínculo antigo
        // pode ser inativado mesmo que tenha sido gravado antes desta validação.
        (data.ativo == false || (
          data.ids_usuarios_responsaveis.size() >= 1 &&
          horariosValidos(data.horarios)
        ));
    }

    match /turma_oficinas/{classWorkshopId} {
      allow read: if canUseSystem();
      allow create: if canUseSystem() &&
        vinculoValido(request.resource.data) &&
        classWorkshopId == request.resource.data.turma_id + '__' + request.resource.data.oficina_id &&
        exists(/databases/$(database)/documents/turmas/$(request.resource.data.turma_id)) &&
        exists(/databases/$(database)/documents/oficinas/$(request.resource.data.oficina_id));
      allow update: if canUseSystem() &&
        vinculoValido(request.resource.data) &&
        request.resource.data.turma_id == resource.data.turma_id &&
        request.resource.data.oficina_id == resource.data.oficina_id;
      allow delete: if false;
    }

    match /matriculas/{enrollmentId} {
      allow read: if canUseSystem();
      allow create, update, delete: if isDirection() || isPedagogue() || isAdministrative();
    }

    match /aluno_oficinas/{assignmentId} {
      allow read: if canUseSystem();
      allow create, update, delete: if isDirection() || isPedagogue();
    }

    match /registros_atividade/{activityId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isDirection();

      // Subcoleção: anexos do registro de atividade (fotos e documentos)
      match /anexos/{attachmentId} {
        allow read: if canUseSystem();
        allow create: if canUseSystem() &&
          exists(/databases/$(database)/documents/registros_atividade/$(activityId)) &&
          request.resource.data.armazenamento == 'firestore' &&
          request.resource.data.status == 'enviando' &&
          request.resource.data.enviado_por == request.auth.uid &&
          request.resource.data.total_partes > 0 && request.resource.data.total_partes <= 100 &&
          request.resource.data.tamanho_bytes > 0 && request.resource.data.tamanho_bytes <= 10485760;
        allow update: if isDirection() || (
          canUseSystem() && resource.data.enviado_por == request.auth.uid &&
          resource.data.status == 'enviando' && request.resource.data.status == 'disponivel' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        );
        allow delete: if isDirection() || (
          canUseSystem() && resource.data.enviado_por == request.auth.uid && resource.data.status == 'enviando'
        );

        match /chunks/{chunkId} {
          function attachmentIsUploading() {
            return exists(/databases/$(database)/documents/registros_atividade/$(activityId)/anexos/$(attachmentId)) &&
              get(/databases/$(database)/documents/registros_atividade/$(activityId)/anexos/$(attachmentId)).data.status == 'enviando';
          }
          allow read: if canUseSystem();
          allow create: if canUseSystem() && attachmentIsUploading() &&
            request.resource.data.indice >= 0 &&
            request.resource.data.indice < get(/databases/$(database)/documents/registros_atividade/$(activityId)/anexos/$(attachmentId)).data.total_partes &&
            request.resource.data.conteudo_base64 is string &&
            request.resource.data.conteudo_base64.size() <= 850000;
          allow update: if false;
          allow delete: if isDirection() || (canUseSystem() && attachmentIsUploading() &&
            get(/databases/$(database)/documents/registros_atividade/$(activityId)/anexos/$(attachmentId)).data.enviado_por == request.auth.uid);
        }
      }
    }

    match /registros_evolucao/{progressId} {
      allow read: if canUseSystem();
      allow create, update: if isDirection() || isPedagogue();
      allow delete: if isDirection();
    }

    match /modelos_formulario/{templateId} {
      allow read: if canUseSystem();
      allow create, update, delete: if isDirection() || isPedagogue();
    }

    match /relatorios_pedagogicos/{reportId} {
      allow read: if isDirection() || isPedagogue();
      allow create, update: if isDirection() || isPedagogue();
      allow delete: if isDirection();

      // Subcoleção: anexos do relatório pedagógico
      match /anexos/{attachmentId} {
        allow read: if isDirection() || isPedagogue();
        allow create: if (isDirection() || isPedagogue()) &&
          isReportDraft(reportId) &&
          request.resource.data.armazenamento == 'firestore' &&
          request.resource.data.status == 'enviando' &&
          request.resource.data.enviado_por == request.auth.uid &&
          request.resource.data.total_partes > 0 && request.resource.data.total_partes <= 100 &&
          request.resource.data.tamanho_bytes > 0 && request.resource.data.tamanho_bytes <= 10485760;
        allow update: if isDirection() || (
          (isPedagogue() || isDirection()) && isReportDraft(reportId) &&
          resource.data.enviado_por == request.auth.uid && resource.data.status == 'enviando' &&
          request.resource.data.status == 'disponivel' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        );
        allow delete: if isDirection() || (
          (isDirection() || isPedagogue()) && isReportDraft(reportId) &&
          resource.data.enviado_por == request.auth.uid && resource.data.status == 'enviando'
        );

        match /chunks/{chunkId} {
          function attachmentIsUploading() {
            return exists(/databases/$(database)/documents/relatorios_pedagogicos/$(reportId)/anexos/$(attachmentId)) &&
              get(/databases/$(database)/documents/relatorios_pedagogicos/$(reportId)/anexos/$(attachmentId)).data.status == 'enviando' &&
              isReportDraft(reportId);
          }
          allow read: if isDirection() || isPedagogue();
          allow create: if (isDirection() || isPedagogue()) && attachmentIsUploading() &&
            request.resource.data.indice >= 0 &&
            request.resource.data.indice < get(/databases/$(database)/documents/relatorios_pedagogicos/$(reportId)/anexos/$(attachmentId)).data.total_partes &&
            request.resource.data.conteudo_base64 is string &&
            request.resource.data.conteudo_base64.size() <= 850000;
          allow update: if false;
          allow delete: if isDirection() || ((isDirection() || isPedagogue()) &&
            isReportDraft(reportId) && attachmentIsUploading() &&
            get(/databases/$(database)/documents/relatorios_pedagogicos/$(reportId)/anexos/$(attachmentId)).data.enviado_por == request.auth.uid);
        }
      }
    }

    // Presenças ficam embutidas no map `presencas` da própria sessão —
    // um documento por chamada, sem coleção auxiliar.
    // Sessão de chamada: uma por data + turma + escopo (geral ou vínculo da
    // oficina). O ID determinístico impede duas sessões para o mesmo contexto;
    // a versão incrementada impede sobrescrever uma chamada salva por outra pessoa.
    function sessaoChamadaValida(d) {
      return d.data_chamada is string &&
        d.data_chamada.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        d.turma_id is string && d.turma_id.size() > 0 &&
        d.escopo in ['turma', 'oficina'] &&
        (d.escopo == 'turma'
          ? d.get('turma_oficina_id', null) == null
          : d.get('turma_oficina_id', null) is string) &&
        d.presencas is map &&
        d.presencas.values().hasOnly(['presente', 'ausente', 'justificado']) &&
        (d.get('observacoes', null) == null || d.observacoes is map) &&
        d.registrado_por is string &&
        d.versao is int;
    }

    function sessaoChamadaId(d) {
      return d.data_chamada + '_' + d.turma_id + '_' +
        (d.escopo == 'turma' ? 'geral' : d.turma_oficina_id);
    }

    match /sessoes_chamada/{sessionId} {
      allow read: if canUseSystem();
      allow create: if canUseSystem() &&
        sessaoChamadaValida(request.resource.data) &&
        request.resource.data.versao == 1 &&
        sessionId == sessaoChamadaId(request.resource.data) &&
        exists(/databases/$(database)/documents/turmas/$(request.resource.data.turma_id)) &&
        (request.resource.data.escopo == 'turma' || (
          exists(/databases/$(database)/documents/turma_oficinas/$(request.resource.data.turma_oficina_id)) &&
          get(/databases/$(database)/documents/turma_oficinas/$(request.resource.data.turma_oficina_id)).data.turma_id == request.resource.data.turma_id &&
          get(/databases/$(database)/documents/turma_oficinas/$(request.resource.data.turma_oficina_id)).data.ativo == true
        ));
      // O contexto (data, turma, escopo, vínculo) não muda depois de criado.
      allow update: if canUseSystem() &&
        sessaoChamadaValida(request.resource.data) &&
        request.resource.data.versao == resource.data.get('versao', 0) + 1 &&
        request.resource.data.data_chamada == resource.data.data_chamada &&
        request.resource.data.turma_id == resource.data.turma_id &&
        request.resource.data.escopo == resource.data.escopo &&
        request.resource.data.get('turma_oficina_id', null) == resource.data.get('turma_oficina_id', null);
      allow delete: if isDirection();
    }

    match /contatos_familia/{contactId} {
      allow read: if canUseSystem();
      allow create: if (isDirection() || isPedagogue() || isAdministrative()) &&
        exists(/databases/$(database)/documents/alunos/$(request.resource.data.aluno_id)) &&
        request.resource.data.responsavel_id is string &&
        exists(/databases/$(database)/documents/alunos/$(request.resource.data.aluno_id)/responsaveis/$(request.resource.data.responsavel_id)) &&
        get(/databases/$(database)/documents/alunos/$(request.resource.data.aluno_id)/responsaveis/$(request.resource.data.responsavel_id)).data.ativo == true &&
        request.resource.data.responsavel_snapshot.nome == get(/databases/$(database)/documents/alunos/$(request.resource.data.aluno_id)/responsaveis/$(request.resource.data.responsavel_id)).data.nome_completo &&
        request.resource.data.responsavel_snapshot.parentesco == get(/databases/$(database)/documents/alunos/$(request.resource.data.aluno_id)/responsaveis/$(request.resource.data.responsavel_id)).data.parentesco &&
        request.resource.data.responsavel_snapshot.contato == get(/databases/$(database)/documents/alunos/$(request.resource.data.aluno_id)/responsaveis/$(request.resource.data.responsavel_id)).data.telefone;
      // Registros de contato preservam o destinatário e os dados usados naquele momento.
      allow update: if false;
      allow delete: if isDirection();
    }

    match /relatorios_gerados/{reportId} {
      allow read: if isDirection();
      allow create: if isDirection()
        && request.resource.data.tipo_relatorio in ['acompanhamento_aluno', 'prestacao_contas']
        && request.resource.data.status == 'processando'
        && request.resource.data.gerado_por == request.auth.uid
        && request.resource.data.gerado_em == request.time
        && request.resource.data.periodo_inicio is string
        && request.resource.data.periodo_fim is string;
      allow update: if isDirection()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'gerado_em'])
        && resource.data.status == 'processando'
        && request.resource.data.status in ['concluido', 'falhou']
        && request.resource.data.gerado_em == request.time;
      allow delete: if isDirection();
    }

    match /configuracoes_sistema/{settingId} {
      allow read: if isDirection();
      allow write: if isDirection();
    }
  }
}
