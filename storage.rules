rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Padrão: negar tudo. Acesso concedido apenas por regras explícitas.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isDirection() {
      return isActiveUser() && userRole() == 'direcao';
    }

    function isActiveUser() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.papel;
    }

    function canUseSystem() {
      return isActiveUser() && userRole() in ['direcao', 'pedagogia', 'administrativo'];
    }

    function canManagePedagogicalFiles() {
      return isActiveUser() && userRole() in ['direcao', 'pedagogia'];
    }

    function isReportDraft(reportId) {
      return firestore.exists(/databases/(default)/documents/relatorios_pedagogicos/$(reportId)) &&
        firestore.get(/databases/(default)/documents/relatorios_pedagogicos/$(reportId)).data.status == 'rascunho';
    }

    function isImageUpTo5MB() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Fotos dos registros de atividade (metadados em registros_atividade/{id}/anexos)
    match /registros_atividade/{activityId}/{fileName} {
      allow read: if canUseSystem();
      allow create: if canUseSystem() && isImageUpTo5MB();
      allow update: if false;
      allow delete: if isDirection();
    }

    // Anexos dos relatórios pedagógicos (fotos e PDFs até 10 MB)
    match /relatorios_pedagogicos/{reportId}/{fileName} {
      allow read: if canManagePedagogicalFiles();
      allow create: if canManagePedagogicalFiles() && isReportDraft(reportId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('(image/.*|application/pdf)');
      allow update: if false;
      allow delete: if isDirection();
    }
  }
}
